    {
      "description": "Zip gerbers into *project_name*_gerber.zip and delete loose files",
      "id": "bbf7835b-fed8-44df-be58-62a6a8803e44",
      "settings": {
        "command": "powershell -Command \"Compress-Archive -Path '${JOBSET_OUTPUT_WORK_PATH}\\gerber\\*' -DestinationPath ('${JOBSET_OUTPUT_WORK_PATH}\\' + (Split-Path '${KIPRJMOD}' -Leaf) + '_gerber.zip') -Force; Remove-Item '${JOBSET_OUTPUT_WORK_PATH}\\gerber' -Recurse -Force\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "bbf7835b-fed8-44df-be58-62a6a8803e44.log",
        "record_output": false
      },
      "type": "special_execute"
    },
    {
      "description": "Generate csv BOM for JLC with Designator/Comment/LCSC Part Number/Package header",
      "id": "311d913e-15ca-429e-ab66-ed54e6d095fd",
      "settings": {
        "bom_format_preset_name": "CSV",
        "bom_preset_name": "",
        "description": "",
        "exclude_dnp": false,
        "field_delimiter": ",",
        "fields_group_by": [
          "JLC_PN"
